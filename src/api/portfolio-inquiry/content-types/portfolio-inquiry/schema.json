{
  "kind": "collectionType",
  "collectionName": "portfolio_inquiries",
  "info": {
    "singularName": "portfolio-inquiry",
    "pluralName": "portfolio-inquiries",
    "displayName": "Portfolio Inquiry",
    "description": "Portfolio inquiries from the Midis portfolio consultation form"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "businessEmail": {
      "type": "email",
      "required": true
    },
    "phoneCountryCode": {
      "type": "string",
      "required": true
    },
    "phoneNumber": {
      "type": "string",
      "required": true
    },
    "websiteUrl": {
      "type": "string",
      "required": false
    },
    "serviceNeeded": {
      "type": "enumeration",
      "enum": [
        "new-website-development",
        "website-redesign",
        "e-commerce-website",
        "landing-page-development",
        "not-sure-yet"
      ],
      "required": true
    },
    "sourceWebsite": {
      "type": "string",
      "default": "midis-portfolio",
      "required": true
    },
    "submissionType": {
      "type": "string",
      "required": false
    },
    "hubspotSyncStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "synced",
        "failed"
      ],
      "default": "pending"
    },
    "hubspotContactId": {
      "type": "string"
    }
  }
}
